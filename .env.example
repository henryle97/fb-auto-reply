# --- Facebook ---
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_APP_SECRET=
# Any random string. Enter the same value when configuring the webhook in the Meta dashboard.
# Also used as the X-Admin-Token for /logs, /reload-rules and /debug/payloads.
FB_VERIFY_TOKEN=
FB_GRAPH_VERSION=v25.0

# --- Behaviour ---
# true = log what would be posted without posting anything
DRY_RUN=true
SEND_PRIVATE_REPLY=true
REPLY_DELAY_MIN=5
REPLY_DELAY_MAX=20

# --- Content (defaults: ./rules.yaml and ./product_info.md, else the files in examples/) ---
# RULES_PATH=
# PRODUCT_INFO_PATH=

# --- AI (Claude) ---
AI_ENABLED=true
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# --- Storage (optional; SQLite is used when Supabase is not configured) ---
SQLITE_PATH=data.db
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
